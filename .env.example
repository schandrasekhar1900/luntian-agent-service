# ---------------------------------------------------------------
# Lia agent service (Twilio Agent Connect). Runs as a long-lived Node
# process because ConversationRelay needs a WebSocket, which Twilio
# Functions can't host. Expose it with an ngrok static domain (or any
# Node host with WebSockets: Render, Fly.io, Cloud Run with 1 instance).
# ---------------------------------------------------------------

# Twilio credentials (same account as the Serverless service)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI agent hotline. Its Voice webhook = https://<this domain>/twiml
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# This service's public domain WITHOUT https:// (ngrok static domain)
TWILIO_VOICE_PUBLIC_DOMAIN=your-name.ngrok-free.app

# Conversation Orchestrator configuration (its status callback = https://<this domain>/webhook)
TWILIO_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Studio flow from the "Twilio Agent Connect - Agent Handoff" template
TWILIO_STUDIO_HANDOFF_FLOW_SID=FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Enterprise Knowledge base (policy search)
TWILIO_KNOWLEDGE_BASE_ID=know_knowledgebase_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Conversations (classic) service that Flex uses
TWILIO_CONVERSATIONS_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used only by setup/provision.js (TAC itself reads the memory store from the Orchestrator configuration)
TWILIO_MEMORY_STORE_ID=mem_store_xxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_INTELLIGENCE_CONFIGURATION_ID=intelligence_configuration_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Memory retrieval tuning (optional)
TWILIO_MEMORY_OBSERVATIONS_LIMIT=25
TWILIO_MEMORY_SUMMARIES_LIMIT=5

# Shared live-event bus (same values as the Serverless service)
SYNC_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FUNCTIONS_DOMAIN=luntian-demo-1234-dev.twil.io
WEBHOOK_KEY=change-me-to-a-long-random-string

# Claude (Anthropic Messages API). Haiku = fastest for voice; claude-sonnet-5-5 = richer answers.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-haiku-5-5

# Demo customer (must match the Serverless .env)
DEMO_CUSTOMER_NAME=Mia Santos
DEMO_CUSTOMER_EMAIL=mia.santos@gmail.com
DEMO_CUSTOMER_PHONE=+65xxxxxxxx
CHAT_AGENT_IDENTITY=lia

# Audience segment (audience branch only). Empty = audience features off.
AUDIENCE_SYNC_SERVICE_SID=
AUDIENCE_HANDOFF_CAP=3

PORT=8000
# trace | debug | info | warn | error ; LOG_PRETTY=false for JSON lines
LOG_LEVEL=debug
LOG_PRETTY=true
